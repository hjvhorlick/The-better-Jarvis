{
  "name": "jarvis",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "lint": "tsc --noEmit",
    "build": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "tsx server.ts",
    "test:brain": "node --import tsx --test tests/brain.node.test.ts",
    "test:knowledge": "node --import tsx --test tests/knowledge.node.test.ts",
    "test:node": "node --import tsx --test tests/*.node.test.ts tests/*.node.test.mjs"
  },
  "dependencies": {
    "@google/genai": "latest",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
