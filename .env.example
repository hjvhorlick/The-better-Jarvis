# Gemini API key for server-side AI processing.
# The same key may instead live in config/api_keys.json as "gemini_api_key" —
# the file the desktop app and every action read. The environment wins when both are set.
GEMINI_API_KEY=

# ── Model names (optional) ────────────────────────────────────────────────────
# Leave these unset and the app's own moving alias is used (gemini-flash-latest),
# which follows Google's current model instead of pinning a version that retires.
# SUPPER_TEXT_MODEL is the application's setting; GEMINI_MODEL is honoured too.
# SUPPER_TEXT_MODEL=
# GEMINI_MODEL=
# SUPPER_IMAGE_MODEL=

# ── Daily Gemini budget (optional) ────────────────────────────────────────────
# Calls per local day the app and the dashboard may make together; the counter
# lives in runtime/quota.json. Unset means the app's default of 20. 0 turns calls off.
# SUPPER_GEMINI_DAILY_BUDGET=

# ── Tests only (leave unset in normal use) ────────────────────────────────────
# SUPPER_GEMINI_BASE_URL=      # point the Gemini client at a stub
# SUPPER_DASHBOARD_PORT=       # the dashboard's port, default 3000
