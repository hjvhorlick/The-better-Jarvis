# Gemini API key for server-side AI processing.
# The same key may instead live in config/api_keys.json as "gemini_api_key" —
# the file the desktop app and every action read. The environment wins when both are set.
GEMINI_API_KEY=

# ── Model names (optional) ────────────────────────────────────────────────────
# Leave these unset and the app's own moving alias is used (gemini-flash-latest),
# which follows Google's current model instead of pinning a version that retires.
# SUPPER_TEXT_MODEL is the application's setting; GEMINI_MODEL is honoured too.
# SUPPER_TEXT_MODEL=
# GEMINI_MODEL=
# SUPPER_IMAGE_MODEL=

# ── JARVIS's server voice (optional) ──────────────────────────────────────────
# The page speaks with the computer's own voice (free, instant) and only falls
# back to a Gemini voice when that cannot be heard. Settings → Voice can pin
# either one. These name the model and the voice used for the server voice;
# leave them unset for the app's defaults.
# SUPPER_VOICE_MODEL=gemini-2.5-flash-preview-tts
# SUPPER_VOICE_NAME=Charon

# ── Daily Gemini budget (optional) ────────────────────────────────────────────
# Calls per local day the app and the dashboard may make together; the counter
# lives in runtime/quota.json. Unset means the app's default of 20. 0 turns calls off.
# SUPPER_GEMINI_DAILY_BUDGET=

# ── The voice's own daily budget (optional) ───────────────────────────────────
# Spoken sentences per local day for the server voice. It has its OWN counter
# (runtime/voice_quota.json) so reading answers aloud can never use up the day's
# answers. Unset means 400. A sentence already spoken is replayed from memory and
# costs nothing.
# SUPPER_GEMINI_VOICE_BUDGET=

# ── The local knowledge base (optional) ───────────────────────────────────────
# Answers kept on this computer in runtime/knowledge.json — the same file the
# desktop app uses. A question it can answer never reaches Gemini.
# SUPPER_KNOWLEDGE_LEARN=off     # stop keeping Gemini's answers (existing ones still work)
# SUPPER_KNOWLEDGE_DAYS=30       # how long a kept Gemini answer lasts

# ── Tests only (leave unset in normal use) ────────────────────────────────────
# SUPPER_GEMINI_BASE_URL=      # point the Gemini client at a stub
# SUPPER_DASHBOARD_PORT=       # the dashboard's port, default 3000
